APP_NAME="uLaxys Identity Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SERVICE_SIGNATURE=
# Redis is optional unless selected as the cache/queue backend.
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=identity_

# --- Identity V2 (I1) ---
# Stable token issuer and the single audience backend services accept.
IDENTITY_ISSUER=
IDENTITY_TOKEN_AUDIENCE=ulaxys-platform
IDENTITY_ACCESS_TOKEN_TTL=600
IDENTITY_REFRESH_TOKEN_TTL=720
IDENTITY_SESSION_TTL_HOURS=12
# PEM material is generated by `php artisan identity:keys:generate` and must be
# mounted from a secret manager in production; never commit private keys.
IDENTITY_KEYS_PATH=
# One-time token delivery: null (audit-only, default) or log (local dev only).
IDENTITY_DELIVERY_DRIVER=null
IDENTITY_DELIVERY_LOG_PATH=
